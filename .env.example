# ── Bilibili ────────────────────────────────────────────────────────────
# SESSDATA cookie from a logged-in browser session. The ONLY auth token the
# bilibili downloader needs. Without it, only public low-res streams work.
BILI_SESSDATA=

# ── Azure Speech (transcription, Stage 3 — fast transcription REST) ──────
# Fast synchronous file transcription: real per-phrase timestamps + multi-locale
# language ID. Endpoint is the resource base, e.g.
# https://<resource>.cognitiveservices.azure.com/
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
# Candidate locales (BCP-47) for language identification, comma-separated.
AZURE_SPEECH_LANGUAGES=zh-CN,en-US

# ── Azure OpenAI (summarization, Stage 4) ───────────────────────────────
# OpenAI SDK Responses API against the Azure .../openai/v1 base_url.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
