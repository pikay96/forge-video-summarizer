# ── Bilibili ────────────────────────────────────────────────────────────
# SESSDATA cookie from a logged-in browser session. The ONLY auth token the
# bilibili downloader needs. Without it, only public low-res streams work.
BILI_SESSDATA=

# ── Azure Speech (transcription, Stage 3 — fast transcription, MAI enhanced) ──
# Fast synchronous file transcription with enhancedMode (MAI) for best mixed
# zh/en text quality. Endpoint is the resource base, e.g.
# https://<resource>.cognitiveservices.azure.com/
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
# Enhanced-mode model (verbatim). Leave default unless you have another.
AZURE_SPEECH_MODEL=mai-transcribe-1.5

# ── Azure OpenAI (summarization, Stage 4) ───────────────────────────────
# OpenAI SDK Responses API against the Azure .../openai/v1 base_url.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Notion (export, Stage 5) ────────────────────────────────────────────
# Internal integration secret (starts with `ntn_`). The integration MUST be
# connected to the parent page (page ••• > Connections > your integration).
NOTION_API_KEY=
# Parent page every summary nests under, as a subpage. 32-hex or dashed UUID —
# from the page's ••• > Copy link (trailing id after the last dash).
NOTION_PARENT_PAGE_ID=
