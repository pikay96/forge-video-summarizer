# ── Bilibili ────────────────────────────────────────────────────────────
# SESSDATA cookie from a logged-in browser session. The ONLY auth token the
# bilibili downloader needs. Without it, only public low-res streams work.
BILI_SESSDATA=

# ── Azure Speech Services (transcription, Stage 3) ──────────────────────
# Fast transcription API: {endpoint}/speechtotext/transcriptions:transcribe
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
# Enhanced-mode model (verbatim). Leave default unless you have another.
AZURE_SPEECH_MODEL=

# ── Azure OpenAI (summarization, Stage 4) ───────────────────────────────
# OpenAI SDK Responses API against the Azure .../openai/v1 base_url.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
